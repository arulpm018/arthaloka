# === Asisten AI — ai-service ===

# API key dari Google AI Studio (https://aistudio.google.com/apikey)
GEMINI_API_KEY=

# Kredensial Firebase Admin — salah satu dari:
# 1) Path ke file service-account JSON hasil "Generate new private key"
#    (Firebase Console → Project settings → Service accounts)
# 2) Isi JSON-nya langsung dalam satu baris
# 3) Kosongkan lalu set env GOOGLE_APPLICATION_CREDENTIALS
FIREBASE_SERVICE_ACCOUNT=

# Shared secret — harus sama dengan AI_SERVICE_KEY di .env Next.js.
# Client hanya bicara lewat proxy /api/ai/*, service ini JANGAN diekspos publik.
AI_SERVICE_KEY=ubah-ini-kunci-rahasia

# Model (sudah default sesuai keinginan; ubah kalau perlu)
AGENT_MODEL_PRIMARY=gemma-4-31b-it
AGENT_MODEL_FALLBACK=gemini-3.5-flash-lite
STT_MODEL=gemini-3.5-flash-lite

# Lain-lain
TIMEZONE=Asia/Jakarta
AI_SERVICE_PORT=8006
AI_ALLOWED_ORIGINS=http://localhost:1806,http://127.0.0.1:1806
