rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Arul & Fifi — by UID and email for maximum security
    function isAllowedUser() {
      return request.auth != null
        && request.auth.uid in ['RPS8bvX5eGerNJDm20RvQS0tnHI2', 'UIioxgSjFceo0lmwAWWnrFLm6uJ2']
        && request.auth.token.email in ['fifi.work27@gmail.com', 'arulpm010@gmail.com'];
    }

    function isValidTransaction() {
      let data = request.resource.data;
      return data.amount > 0
        && data.name.size() > 0
        && data.type in ['expense', 'income']
        && data.owner in ['arul', 'fifi', 'shared'];
    }

    match /users/{userId} {
      // Both whitelisted users can read each other's profile (needed for shared finance app)
      allow read: if isAllowedUser();
      allow write: if isAllowedUser() && request.auth.uid == userId;
    }

    match /accounts/{accountId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      // Both partners can manage each other's accounts (shared finance app for 2 whitelisted users)
      allow update, delete: if isAllowedUser();
    }

    match /transactions/{txId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && isValidTransaction();
      allow update, delete: if isAllowedUser();
    }

    match /transfers/{transferId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      allow update, delete: if isAllowedUser();
    }

    match /categories/{catId} {
      allow read, write: if isAllowedUser();
    }

    match /wishlistItems/{itemId} {
      allow read, write: if isAllowedUser();
    }

    match /wishlistCategories/{catId} {
      allow read, write: if isAllowedUser();
    }

    match /memes/{memeId} {
      allow read, write: if isAllowedUser();
    }

    // Modul Produktivitas — to-do, jadwal, habit.
    // Scoping (owner/uid) ditegakkan di level query app, sama seperti
    // pola koleksi finance lainnya.
    match /tasks/{taskId} {
      allow read, write: if isAllowedUser();
    }

    match /events/{eventId} {
      allow read, write: if isAllowedUser();
    }

    match /habits/{habitId} {
      allow read, write: if isAllowedUser();
    }

    // Single shared slot untuk foto couple (data URL inline).
    match /appConfig/{docId} {
      allow read, write: if isAllowedUser();
    }
  }
}
