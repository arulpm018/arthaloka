rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Only Arul & Fifi — by UID and email for maximum security
    function isAllowedUser() {
      return request.auth != null
        && request.auth.uid in ['RPS8bvX5eGerNJDm20RvQS0tnHI2', 'UIioxgSjFceo0lmwAWWnrFLm6uJ2']
        && request.auth.token.email in ['fifi.work27@gmail.com', 'arulpm010@gmail.com'];
    }

    function isOwnerOrPartner(ownerUid) {
      let userDoc = get(/databases/$(database)/documents/users/$(request.auth.uid));
      return request.auth.uid == ownerUid || userDoc.data.partnerUid == ownerUid;
    }

    function isValidTransaction() {
      let data = request.resource.data;
      return data.amount > 0
        && data.name.size() > 0
        && data.type in ['expense', 'income']
        && data.owner in ['arul', 'fifi', 'shared'];
    }

    match /users/{userId} {
      allow read: if isAllowedUser() && (request.auth.uid == userId ||
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.partnerUid == userId);
      allow write: if isAllowedUser() && request.auth.uid == userId;
    }

    match /accounts/{accountId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      allow update, delete: if isAllowedUser() && isOwnerOrPartner(resource.data.ownerUid);
    }

    match /transactions/{txId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser() && isValidTransaction();
      allow update, delete: if isAllowedUser() && isOwnerOrPartner(resource.data.ownerUid);
    }

    match /transfers/{transferId} {
      allow read: if isAllowedUser();
      allow create: if isAllowedUser();
      allow update, delete: if isAllowedUser() && isOwnerOrPartner(resource.data.ownerUid);
    }

    match /categories/{catId} {
      allow read, write: if isAllowedUser();
    }
  }
}
