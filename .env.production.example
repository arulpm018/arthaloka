# Runtime secrets untuk container monolith (docker compose env_file).
# File ini JANGAN di-commit — isi lalu rename jadi .env.production.

# API key Google AI Studio (AI asisten)
GEMINI_API_KEY=

# Service account Firebase dalam SATU BARIS JSON:
#Firebase Console → Project settings → Service accounts → Generate new private key
#lalu jadikan satu baris (mis. pakai: jq -c . file.json)
FIREBASE_SERVICE_ACCOUNT=

# Shared secret proxy → ai-service (bebas, buat panjang)
AI_SERVICE_KEY=
