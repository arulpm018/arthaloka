# Firebase Configuration
# Copy this file to .env.local and fill in your Firebase project credentials
# Get these from: Firebase Console > Project Settings > General > Your apps > Web app

NEXT_PUBLIC_FIREBASE_API_KEY=your-api-key-here
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
NEXT_PUBLIC_FIREBASE_APP_ID=your-app-id

# Allowed Emails (comma-separated)
NEXT_PUBLIC_ALLOWED_EMAILS=email1@gmail.com,email2@gmail.com

# Asisten AI (proxy → ai-service, lihat ai-service/README.md)
AI_SERVICE_URL=http://127.0.0.1:8006
AI_SERVICE_KEY=ubah-ini-kunci-rahasia
